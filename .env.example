# ==============================================================================
# PR Inspection Assistant - Environment Variables Example
# ==============================================================================
# Copy this file to .env.local and fill in your actual values for local testing
# ==============================================================================

# Azure DevOps Configuration
# ------------------------------------------------------------------------------
# System.AccessToken is automatically provided by Azure DevOps in pipelines
# For local testing, you need to create a Personal Access Token (PAT)
# https://docs.microsoft.com/en-us/azure/devops/organizations/accounts/use-personal-access-tokens-to-authenticate
System_AccessToken=your_azure_devops_pat_here

# Collection URI (e.g., https://dev.azure.com/yourorganization/)
System_CollectionUri=https://dev.azure.com/yourorganization/

# Team Project name
System_TeamProject=YourProjectName

# Pull Request ID
System_PullRequest_PullRequestId=123

# Pull Request target branch (e.g., main, develop)
System_PullRequest_TargetBranchName=main

# Repository name
Build_Repository_Name=your-repo-name

# Working directory (local path to your git repository for testing)
System_DefaultWorkingDirectory=C:/path/to/your/local/repository


# OpenAI Configuration
# ------------------------------------------------------------------------------
# OpenAI API Key (required)
# Get your API key from: https://platform.openai.com/api-keys
api_key=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure OpenAI Configuration (optional - only if using Azure OpenAI)
# ------------------------------------------------------------------------------
# Azure OpenAI Service Endpoint (e.g., https://your-resource.openai.azure.com/)
api_endpoint=

# Azure OpenAI API Version (e.g., 2024-10-21)
# See: https://learn.microsoft.com/en-us/azure/ai-services/openai/api-version-deprecation
api_version=

# AI Model / Deployment Name
# Options: o4-mini, o3-mini, o1-mini, o1-preview, o1, gpt-4o, gpt-4, gpt-3.5-turbo
ai_model=o4-mini


# Review Options
# ------------------------------------------------------------------------------
# Check for bugs (true/false)
bugs=false

# Check for performance issues (true/false)
performance=false

# Check for best practices (true/false)
best_practices=false

# Only review modified lines (true/false)
modified_lines_only=true

# Enable comment line number correction (true/false)
comment_line_correction=true

# Allow reviewing on pipeline requeues (true/false)
allow_requeue=false


# File Filtering
# ------------------------------------------------------------------------------
# DEPRECATED - Use file_includes instead
# Comma-separated list of file extensions to include (e.g., .js,.ts,.py)
file_extensions=

# DEPRECATED - Use file_excludes instead
# Comma-separated list of file extensions to exclude (e.g., .test.js,.spec.ts)
file_extension_excludes=

# Comma-separated list of glob patterns for files to include (e.g., src/**/*.ts,lib/**/*.js)
file_includes=

# Comma-separated list of glob patterns for files to exclude (e.g., **/*.test.ts,**/*.spec.js)
file_excludes=


# Advanced Options
# ------------------------------------------------------------------------------
# Additional prompts for the AI (comma-separated)
# Example: "Focus on security,Check for SQL injection,Review error handling"
additional_prompts=

# Enable verbose logging for debugging (true/false)
verbose_logging=false

# Enable confidence mode - filter comments by confidence score (true/false)
# EXPERIMENTAL: AI will rate its confidence in each comment
confidence_mode=false

# Minimum confidence score (1-10) for comments to be shown
# Only used when confidence_mode=true
confidence_minimum=9

# Enable deduplication of similar comments across files (true/false)
dedupe_across_files=false

# Threshold of total PR comments before deduplication kicks in
# Only used when dedupe_across_files=true
dedupe_across_files_threshold=10


# Development/Testing
# ------------------------------------------------------------------------------
# Set to true when running locally for testing
isDevelopment=true

# Debug mode (enables additional console logging)
debug=true
